# Base URL of the FastAPI backend (no trailing slash).
# Leave EMPTY for local dev — Vite proxies /api to VITE_DEV_API_TARGET.
# In production (Cloudflare Pages), set this to your backend URL, e.g.:
# VITE_API_BASE_URL=https://assessments-api.your-domain.com
VITE_API_BASE_URL=

# Local dev only: where Vite proxies /api requests.
VITE_DEV_API_TARGET=http://localhost:8080
