# ---- General ----
APP_NAME="Candidate Assessment API"
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins (used for CORS + link building).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database ----
# Local SQLite by default. For Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# ---- Admin auth (single admin account) ----
ADMIN_EMAIL=admin@example.com
# CHANGE THIS in production to a strong secret.
ADMIN_PASSWORD=change-me-in-prod
# CHANGE THIS to a long random string in production.
JWT_SECRET=insecure-dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# ---- Uploads ----
MAX_UPLOAD_BYTES=10485760       # 10 MB
SESSION_EXPIRY_DAYS=14          # 0 = links never expire

# ---- Storage ----
# "local" writes to disk (dev). "r2" uses Cloudflare R2 (S3-compatible).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/files

# Cloudflare R2 (only needed when STORAGE_BACKEND=r2)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=assessments
R2_REGION=auto
